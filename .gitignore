input_reports/
*.pdf

# Результаты обработки: изображения страниц и OCR-тексты
results/
results_*/
pages/
processed_pages/
ocr_text/
ocr_reports/
*.png
*.jpg

# Промежуточные таблицы (пересоздаются скриптами)
*.csv
!dar-site/data/*.csv
!experiments/*/*.csv

# Рабочие файлы экспериментов: картинки, OCR-тексты, модели
experiments/*/work/

# Отладка
page_debug.html
*.log
